# Copy to .env and fill in. All vars are prefixed TREND_ (see config.py).

# --- OpenAI (required for analysis) ---
TREND_OPENAI_API_KEY=sk-...
TREND_OPENAI_MODEL=gpt-4o
TREND_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Apify (Instagram / TikTok / X / Facebook / LinkedIn). Leave empty to skip paid scrapers ---
TREND_APIFY_TOKEN=

# --- Free official APIs ---
TREND_YOUTUBE_API_KEY=
TREND_REDDIT_CLIENT_ID=
TREND_REDDIT_CLIENT_SECRET=
TREND_REDDIT_USER_AGENT=social-trend-analyzer/1.0

# --- Optional: RAG vector store ---
TREND_QDRANT_URL=
TREND_QDRANT_API_KEY=

# --- Optional: storage (Google Sheets). Without these, sheet I/O is a logged no-op ---
TREND_GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
TREND_GOOGLE_SHEET_ID=

# --- Optional: extras ---
TREND_BUZZSUMO_API_KEY=
TREND_NOTION_TOKEN=

# --- Instagram Growth Agent ---
# Credentials are loaded from MongoDB (collection keyed by credential_id), not env.
TREND_MONGO_URI=
TREND_MONGO_DB=project_db
TREND_IG_CREDENTIAL_COLLECTION=instagram_accounts
# Optional Fernet key to decrypt password/totp_seed at rest (recommended).
TREND_FERNET_KEY=
# Where instagrapi sessions are cached to avoid repeat logins.
TREND_IG_SESSION_DIR=./.ig_sessions
